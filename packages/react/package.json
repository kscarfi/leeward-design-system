{
  "name": "@leeward/react",
  "version": "0.3.0",
  "description": "Leeward Design System for React: accessible components and banking patterns, themed by @leeward/tokens.",
  "keywords": [
    "react",
    "design-system",
    "components",
    "accessibility",
    "wcag",
    "banking",
    "fintech"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "build:pkg": "vite build -c vite.lib.config.ts && node build/styles.ts && tsc -p tsconfig.build.json && node ../../scripts/rewrite-dts-imports.ts dist/types",
    "prepack": "pnpm run build:pkg"
  },
  "dependencies": {
    "@leeward/tokens": "workspace:^",
    "radix-ui": "1.8.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "10.6.7",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.7",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/global.css",
    "./fonts.css": "./src/styles/fonts.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "author": "Kemal Salih Carfi (https://kscarfi.com)",
  "homepage": "https://github.com/kscarfi/leeward-design-system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kscarfi/leeward-design-system.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/kscarfi/leeward-design-system/issues",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./fonts.css": "./dist/fonts.css"
    }
  },
  "files": [
    "dist"
  ]
}
