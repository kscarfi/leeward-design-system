{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.deep.950}",
        "$description": "App background behind all surfaces"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.deep.900}"
      },
      "raised": {
        "$value": "{color.deep.850}",
        "$description": "Cards and menus. Pair with an elevation token."
      },
      "overlay": {
        "$value": "{color.deep.800}",
        "$description": "Dialogs, popovers, toasts"
      },
      "sunken": {
        "$value": "{color.deep.950}"
      },
      "inverse": {
        "$value": "{color.ink.50}"
      },
      "hover": {
        "$value": "{color.deep.800}"
      },
      "pressed": {
        "$value": "{color.deep.700}"
      },
      "brand": {
        "$value": "{color.deep.800}",
        "$description": "Tinted surface for selected or highlighted items"
      }
    },
    "scrim": {
      "$value": "#0000009e",
      "$description": "Backdrop behind dialogs"
    },
    "text": {
      "primary": {
        "$value": "{color.ink.50}"
      },
      "secondary": {
        "$value": "{color.ink.200}"
      },
      "tertiary": {
        "$value": "{color.ink.300}",
        "$description": "Hints, captions, placeholders. Still AA."
      },
      "disabled": {
        "$value": "{color.ink.500}",
        "$description": "Exempt from contrast rules. Never the only cue."
      },
      "inverse": {
        "$value": "{color.ink.950}"
      },
      "link": {
        "$value": "{color.iris.300}"
