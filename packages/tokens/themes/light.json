      },
      "default": {
        "$value": "{color.ink.400}",
        "$description": "Input and control boundaries. At least 3:1."
      },
      "strong": {
        "$value": "{color.ink.600}"
      },
      "focus": {
        "$value": "{color.iris.600}",
        "$description": "Focus ring. At least 3:1 against every surface."
      },
      "brand": {
        "$value": "{color.iris.600}"
      },
      "danger": {
        "$value": "{color.danger.500}"
      }
    },
