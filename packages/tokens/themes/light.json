{
  "color": {
    "$type": "color",
    "bg": {
      "canvas": {
        "$value": "{color.ink.50}",
        "$description": "App background behind all surfaces"
      }
    },
    "surface": {
      "default": {
        "$value": "{color.white}"
      },
      "raised": {
        "$value": "{color.white}",
        "$description": "Cards and menus. Pair with an elevation token."
      },
      "overlay": {
        "$value": "{color.white}",
        "$description": "Dialogs, popovers, toasts"
      },
      "sunken": {
        "$value": "{color.ink.100}"
      },
      "inverse": {
        "$value": "{color.ink.950}"
      },
      "hover": {
        "$value": "{color.ink.100}"
      },
      "pressed": {
        "$value": "{color.ink.200}"
      },
      "brand": {
        "$value": "{color.iris.50}",
        "$description": "Tinted surface for selected or highlighted items"
      }
    },
    "scrim": {
      "$value": "#16163a7a",
      "$description": "Backdrop behind dialogs"
    },
    "text": {
      "primary": {
        "$value": "{color.ink.950}"
      },
      "secondary": {
        "$value": "{color.ink.600}"
      },
      "tertiary": {
        "$value": "{color.ink.500}",
        "$description": "Hints, captions, placeholders. Still AA."
      },
      "disabled": {
        "$value": "{color.ink.400}",
        "$description": "Exempt from contrast rules. Never the only cue."
      },
      "inverse": {
        "$value": "{color.ink.50}"
      },
      "link": {
        "$value": "{color.iris.600}"
