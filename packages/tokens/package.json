{
  "name": "@leeward/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Design tokens in DTCG format, compiled with Style Dictionary.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build/build.ts",
    "generate": "node build/generate-primitives.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test build/*.test.ts"
  },
  "devDependencies": {
    "colorjs.io": "0.7.1",
    "style-dictionary": "5.8.0"
  },
  "exports": {
    ".": "./dist/ts/index.ts",
    "./css": "./dist/css/tokens.css",
    "./css/*": "./dist/css/*",
    "./figma/*": "./dist/figma/*",
    "./palette": "./build/palette.ts",
    "./themes": "./build/themes.ts",
    "./build": "./build/build.ts",
    "./tokens.json": "./dist/ts/leeward.light.json",
    "./partners/*": "./partners/*",
    "./contrast": "./build/contrast.ts",
    "./partner": "./build/partner.ts",
    "./primitives.json": "./src/primitive/color.json"
  },
  "files": [
    "dist",
    "build",
    "src",
    "themes",
    "partners",
    "reference"
  ]
}
