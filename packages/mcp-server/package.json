{
  "name": "@leeward/mcp-server",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server that exposes Leeward tokens, components and rules to AI agents.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "@leeward/tokens": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "typescript": "6.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0"
  },
  "bin": {
    "leeward-mcp": "./src/index.ts"
  },
  "exports": {
    ".": "./src/server.ts",
    "./validate": "./src/validate.ts",
    "./guidelines": "./src/guidelines.ts"
  }
}
