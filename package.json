{
  "name": "leeward-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source, AI-ready design system for digital banking.",
  "license": "MIT",
  "author": "Kemal Salih Carfi (https://kscarfi.com)",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint . && stylelint \"packages/**/*.css\" \"apps/**/*.css\"",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check:copy": "node scripts/check-copy.ts",
    "contrast": "node scripts/contrast-report.ts",
    "build:tokens": "pnpm --filter @leeward/tokens build",
    "test:stories": "pnpm --filter @leeward/docs test-storybook",
    "storybook": "pnpm --filter @leeward/docs storybook",
    "build:agent": "node scripts/sync-docs-tokens.ts && node scripts/build-agent-docs.ts",
    "theme:generate": "node scripts/generate-theme.ts",
    "icons:import": "node scripts/import-solar-icons.ts",
    "check:examples": "node scripts/check-docs-examples.ts",
    "check:links": "node scripts/check-links.ts",
    "check:coverage": "node scripts/check-coverage.ts",
    "check:docs-tokens": "node scripts/sync-docs-tokens.ts --check",
    "smoke:packages": "node scripts/smoke-packages.ts",
    "size": "node packages/react/build/size.ts"
  },
  "devDependencies": {
    "@leeward/lint": "workspace:*",
    "@leeward/tokens": "workspace:*",
    "@types/node": "26.6.6",
    "colorjs.io": "0.7.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "stylelint": "18.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "homepage": "https://github.com/kscarfi/leeward-design-system"
}
