{
  "name": "leeward-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source, AI-ready design system for a fictional digital bank.",
  "license": "MIT",
  "author": "Kemal Salih Carfi",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "check:copy": "node scripts/check-copy.ts",
    "contrast": "node scripts/contrast-report.ts",
    "build:tokens": "pnpm --filter @leeward/tokens build",
    "test:stories": "pnpm --filter @leeward/docs test-storybook",
    "storybook": "pnpm --filter @leeward/docs storybook"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "6.0.3",
    "@leeward/tokens": "workspace:*",
    "colorjs.io": "0.7.1"
  }
}
